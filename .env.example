# Local dev defaults — see SPEC.md §10.2 for why these gates exist and how they escalate in prod.
ENV=development

# Storage backend: sqlite (recommended for dev) | h5 | postgres (Phase B)
STORAGE_BACKEND=sqlite
STORAGE_PATH=./dev.sqlite3

# Fraud seating check: enabled | log_only | disabled
# MUST be enabled whenever real payout credentials are configured (server refuses to boot otherwise).
FRAUD_SEATING_CHECK=disabled

PAYOUT_PROVIDER=demo

JWT_SECRET=dev-secret-change-me
